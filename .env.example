# Copy to .env and change what you need; docker compose reads .env from this folder.
# .env is in .gitignore.

# rag: the answer mode when a request does not name one.
#   rag     = the full pipeline (retrieved provisions in the prompt)
#   no_rag  = the same LLM and prompt without retrieved provisions (no-RAG baseline)
ELIZA_MODE=rag

# rag: where Ollama runs. The ollama container uses only the CPU (also on a Mac).
# For faster answers while developing on a Mac, use the Ollama app on the Mac instead:
#   OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M

# web: the port on this computer (http://localhost:WEB_PORT)
WEB_PORT=3000

# web: session parameters (open in the design document, section 7; these are first values)
SESSION_TTL_MINUTES=30
HISTORY_PAIRS=3
RATE_LIMIT_PER_MINUTE=10
RAG_TIMEOUT_S=180
