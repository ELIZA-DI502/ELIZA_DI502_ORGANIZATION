# Copy to .env and change what you need; docker compose reads .env from this folder.
# .env is in .gitignore.

# rag: the answer mode when a request does not name one.
#   rag     = the 8 chunks found by the retrieval are in the prompt (src/rag_vs_no_rag.ipynb)
#   no_rag  = no retrieval: all 105 chunks of data/chunks.jsonl are in the prompt (about 8,700 tokens)
ELIZA_MODE=rag

# rag: where Ollama runs. The ollama container uses only the CPU (also on a Mac).
# For faster answers while developing on a Mac, use the Ollama app on the Mac instead:
#   OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
# Empty = the answer model of config/rag.yaml (hf.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q4_K_M),
# the model of the notebook's answers.
LLM_MODEL=
# no_rag mode: Ollama's context window for the 105 chunks
NUM_CTX_ALL_CHUNKS=12288

# web: the port on this computer (http://localhost:WEB_PORT)
WEB_PORT=3000

# web: session parameters (open in the design document, section 7; these are first values)
SESSION_TTL_MINUTES=30
HISTORY_PAIRS=3
RATE_LIMIT_PER_MINUTE=10
# The first no_rag answer of a session reads the whole prompt; on a CPU this can take minutes.
RAG_TIMEOUT_S=600
